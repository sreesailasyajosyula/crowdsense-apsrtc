# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000

# Path to the downloaded Firebase service account JSON file.
# Put the actual json file somewhere OUTSIDE version control (e.g. server/secrets/)
# and point this at it. Used for LOCAL development.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccountKey.json

# For hosting platforms (Render, Railway, etc.) that don't let you upload
# a file: paste the ENTIRE contents of your service account JSON here as
# one line instead, and leave FIREBASE_SERVICE_ACCOUNT_PATH unset there.
# If both are set, FIREBASE_SERVICE_ACCOUNT_JSON takes priority.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Your Firebase project ID (same as in the frontend firebaseConfig)
FIREBASE_PROJECT_ID=crowdsense-apsrtc

# Once deployed, set this to your exact frontend URL (e.g.
# https://your-app.vercel.app) to restrict API access to just your site.
# Leave blank for local development.
FRONTEND_URL=

# Comma-separated list of admin phone numbers (E.164 format, e.g. +919876543210)
# Anyone logging in with one of these numbers is treated as an admin.
ADMIN_PHONE_NUMBERS=

# AI Recommendation Engine thresholds (see brief: "20+ passengers, same
# route/time, high crowd score"). Lower these temporarily while testing
# with a small number of journeys; restore to real values (20 / 70) for
# actual use.
RECOMMENDATION_MIN_REPORTS=20
RECOMMENDATION_MIN_CROWD_SCORE=70
